{
    "name": "pointybeard/reverse-regex",
    "description": "Generate text from a regular expression",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "regex",
        "generator"
    ],
    "authors": [
        {
            "name": "Alannah Kearney",
            "email": "hi@alannahkearney.com",
            "homepage": "https://github.com/pointybeard"
        }
    ],
    "homepage": "http://github.com/pointybeard-forks/reverse-regex",
    "support": {
        "issues": "https://github.com/pointybeard-forks/reverse-regex/issues",
        "wiki": "https://github.com/pointybeard-forks/reverse-regex/wiki"
    },
    "require": {
        "php": ">=8.2",
        "doctrine/collections": "^2.0",
        "doctrine/lexer": "^3.0",
        "symfony/polyfill-mbstring": "^1.23"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.16",
        "laravel/pint": "^1.0",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpdoc-parser": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-mockery": "^1.1",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tests\\": "tests/",
            "pointybeard\\ReverseRegex\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        }
    },
    "scripts": {
        "test": [
            "pint --test",
            "parallel-lint --exclude vendor .",
            "phpstan analyse --memory-limit=2G",
            "phpunit"
        ],
        "tidy": [
            "composer normalize",
            "pint"
        ]
    }
}
